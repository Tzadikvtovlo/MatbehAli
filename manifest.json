{
  "manifest_version": 3,
  "name": "מטבעלי",
  "version": "1.0",
  "description": "אוסף מטבעות AliExpress יומיים",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.aliexpress.com/"
  ],
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_title": "מטבעלי",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}